# 정부 공식 API 인증키 (각 사이트에서 발급 후 .env.local 로 복사해 채우세요)

# 온통청년(youthcenter.go.kr) 청년정책 API
#  발급: https://www.youthcenter.go.kr 로그인 → 마이페이지 → 오픈(OPEN) API 신청
YOUTHCENTER_API_KEY=

# (후속 추가 예정)
# 공공데이터포털(data.go.kr) 서비스키 — 복지로/보조금24, 대학알리미 등
# DATA_GO_KR_SERVICE_KEY=

# AI 지원서 작성 (없으면 기능만 비활성, 앱은 정상 동작)
ANTHROPIC_API_KEY=

# 유료 이용권 (아래 4개가 모두 있어야 결제 게이트가 켜짐 — 없으면 무료 동작)
#  토스페이먼츠: https://developers.tosspayments.com (비사업자 가입 가능, 테스트 키로 먼저 검증)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
#  Supabase: 프로젝트 만들고 supabase/schema.sql 실행 후 키 복사
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
